{
	"version": "0.0.62",
	"scripts": {
		"secure_dev": "cross-env https=true ts-node ./server/index.ts",
		"dev": "cross-env https=false ts-node ./server/index.ts",
		"prod": "npm run build && npm start",
		"build": "tsc ./server/*.ts --esModuleInterop && vite build && vite build --ssr",
		"start": "cross-env NODE_ENV=production node ./server/index.js",
		"deploy": "git pull --no-edit && npm run build && pm2 restart ecosystem.config.js"
	},
	"dependencies": {
		"@meforma/vue-toaster": "^1.3.0",
		"@rushstack/eslint-patch": "^1.1.0",
		"@vitejs/plugin-vue": "^1.2.5",
