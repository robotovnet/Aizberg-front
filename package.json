		"axios": "^1.6.4",
		"cookie-parser": "^1.4.5",
		"dayjs": "^1.11.2",
		"dotenv": "^10.0.0",
		"express": "^4.19.2",
		"imask": "^6.1.0",
		"stylus": "^0.55.0",
		"stylus-loader": "^3.0.2",
		"validatorjs": "^3.22.1",
		"vite": "^2.9.16",
		"vite-plugin-ssr": "^0.1.5",
		"vue": "^3.1.4",
		"vue-i18n": "^9.1.7",
		"vuex": "^4.0.2"
	},
	"devDependencies": {
		"@types/express": "^4.17.13",
		"@types/node": "^16.3.2",
		"@types/validatorjs": "^3.15.0",
		"@typescript-eslint/eslint-plugin": "^5.12.1",
		"@typescript-eslint/parser": "^5.12.1",
		"@vue/compiler-sfc": "^3.2.31",
		"@vue/eslint-config-typescript": "^10.0.0",
		"bootstrap": "^5.0.2",
		"cross-env": "^7.0.3",
		"eslint": "^8.9.0",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-plugin-import": "^2.25.4",
		"eslint-plugin-vue": "^8.5.0",
		"sass": "^1.35.2",
		"ts-node": "^10.1.0",
		"typescript": "^4.3.5"
	},
	"name": "aizberg-front",
