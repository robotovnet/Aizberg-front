# Порты Node-сервера (используются в production-режиме)
PORT=8085
HTTPS_PORT=443

# SSL (опционально). Без сертификатов запускается только HTTP-сервер
#SSL_CERT_PATH=./server/ssl/server.cert
#SSL_KEY_PATH=./server/ssl/server.key
#SSL_CA_PATH=./server/ssl/ca.cert

# Публичный адрес API Aizberg — к нему обращается браузер. Обязательно с "/" в конце
VITE_API_URL=https://api.domain.com/

# Адрес API для запросов с сервера панели (проверка сессии при рендеринге страниц).
# В Docker Compose проекта Aizberg — адрес контейнера Nginx
VITE_DOCKER_API_URL=http://webserver:8444

# ID группы сотрудников «Менеджеры» — для фильтров по менеджеру в заказах и клиентах
VITE_MANAGER_GROUP_ID=3

# Показывать переключатель языка интерфейса
#VITE_SHOW_LANGUAGE_SWITCHER=true

# Названия разделов каталога через запятую, для товаров которых доступны тип матрицы и прайс для 1С
#VITE_MATRIX_SECTIONS=Матрицы в сборе,Матрицы для ноутбуков,Матрицы для планшетов
