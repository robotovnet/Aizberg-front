{
	"compilerOptions": {
		"strict": true,
		"module": "ES2020",
		"moduleResolution": "Node",
		"target": "ES2017",
		"lib": ["DOM"],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noImplicitAny": false,
		"types": ["vite/client"],
		"jsx": "preserve"
	},
	"ts-node": {
		"transpileOnly": true,
		"compilerOptions": {
			"module": "CommonJS"
		}
	}
}
