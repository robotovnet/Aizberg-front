{
	"semi": true,
	"singleQuote": true,
	"useTabs": true,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"bracketSpacing": true,
	"tabWidth": 4,
	"bracketSameLine": true,
	"arrowParens": "avoid",
	"htmlWhitespaceSensitivity": "css",
	"vueIndentScriptAndStyle": false,
	"endOfLine": "lf",
	"embeddedLanguageFormatting": "auto",
	"singleAttributePerLine": false,
	"printWidth": 140
}
